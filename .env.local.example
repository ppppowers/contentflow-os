# --- Public (safe for browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (NEVER prefix with NEXT_PUBLIC) ---
# Service role bypasses RLS. Used only in trusted server contexts (onboarding).
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (Phase 7+). Server only.
ANTHROPIC_API_KEY=

# OpenAI — image generation only. Server only.
OPENAI_API_KEY=
# Optional: override the image model (default gpt-image-2).
OPENAI_IMAGE_MODEL=

# SEO Studio publishing (GitHub pull requests) and weekly monitor. Server only.
GITHUB_TOKEN=
CRON_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
